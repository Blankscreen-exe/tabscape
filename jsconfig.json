{
  "compilerOptions": {
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true
  },
  "include": ["core/**/*.js", "themes/**/*.js", "widgets/**/*.js"],
  "exclude": ["demos", "vendor"]
}
